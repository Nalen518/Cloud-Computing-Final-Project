        <mxCell id="security" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" value="&lt;b&gt;Security :&amp;nbsp;&lt;/b&gt;&lt;br&gt;HTTPS only, API key + usage-plan throttling,&amp;nbsp; DynamoDB encrypted at rest and no VPC (managed services over HTTPS)&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="1120" x="40" y="630" as="geometry" />
        </mxCell>
        <mxCell id="flow" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" value="&lt;b&gt;Request flow :&amp;nbsp;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;1.&amp;nbsp; Client sends an HTTPS request with the x-api-key header&lt;br&gt;2.&amp;nbsp; API Gateway checks the key and throttle, then invokes Lambda&lt;br&gt;3.&amp;nbsp; Lambda validates input and calls DynamoDB&lt;br&gt;4.&amp;nbsp; DynamoDB returns the item or the result&lt;br&gt;5. Lambda returns a status code and a JSON body&lt;br&gt;6.&amp;nbsp; API Gateway returns the response to the client&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="520" x="40" y="700" as="geometry" />
        </mxCell>
        <mxCell id="endpoints" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" value="&lt;b&gt;CRUD endpoints (entity: Item)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;POST /items → 201 | 400&lt;br&gt;GET /items/{itemId} → 200 | 404&lt;br&gt;PUT /items/{itemId} → 200 | 400 | 404&lt;br&gt;DELETE /items/{itemId} → 204 | 404&lt;br&gt;&lt;span style=&quot;color:#545B64&quot;&gt;stretch: GET /items?lowStock=true (scan)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="460" x="640" y="700" as="geometry" />
        </mxCell>
